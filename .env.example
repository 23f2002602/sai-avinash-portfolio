# Create a Meta app with Instagram API with Instagram Login and add this redirect URL.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-domain.vercel.app/api/instagram/callback

# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_ADMIN_SECRET=
CRON_SECRET=

# Connect an Upstash Redis database through Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
